extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main 
    +alert-error(5000)

    h1(class='mb-4') Add a new role 

    form(
        action=`${prefixAdmin}/roles/create`
        method='POST'
    )
        div(class='form-group')
            label(for='title') Title
            input(
                type='text'
                id='title'
                class='form-control'
                name='title'
                required
            )
        
        div(class='form-group')
            label(for='desc') Description 
            input(
                type='text'
                id='desc'
                class='form-control'
                name='description'
            )

        div(class='form-group')
            button(
                type='submit'
                class='btn btn-primary'
            ) Create New