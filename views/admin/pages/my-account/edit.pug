extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main 
    h1(class='mb-4') Edit an account 

    +alert-error(5000)
    +alert-success(5000)

    if(roles)
        form(
            action=`${prefixAdmin}/my-accounts/edit?_method=PATCH`
            method='POST'
            enctype='multipart/form-data'
        )
            div(class='form-group')
                label(for='fullName') Full Name *
                input(
                    type="text"
                    class='form-control'
                    id='fullName'
                    name='fullName'
                    required
                    value=user.fullName
                )

            div(class='form-group')
                label(for='email') Email *
                input(
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                    required
                    value=user.email
                )
            
            div(class='form-group')
                label(for='password') Password *
                input(
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                )

            div(class='form-group')
                label(for='phone') Phone number
                input(
                    type="text"
                    class="form-control"
                    id="phone"
                    name="phone"
                    value=user.phone
                )

            div(
                class='form-group'
                upload-image
            )
                label(for="avatar") Avatar 
                input(
                    type="file"
                    class="form-control"
                    id="avatar"
                    name="avatar"
                    accept="image/*"
                    upload-image-input
                )
                img(
                    src=user.avatar
                    class="image-preview"
                    upload-image-preview
                )

            div(class="form-group")
                label(for="role_id") Role 
                select(name="role_id" id="role_id" class="form-control")
                    option(disabled) -- Select --
                    each item in roles 
                        option(
                            value=item.id
                            selected=(item.id == user.role_id ? true : false)
                        ) #{item.title}

            div(class="form-group form-check form-check-inline")
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusActive"
                    name="status"
                    value="active"
                    checked=(user.status == "active" ? true : false)
                )
                label(for="statusActive" class="form-check-label") Active 

            div(class="form-group form-check form-check-inline")
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusInactive"
                    name="status"
                    value="inactive"
                    checked=(user.status == "inactive" ? true : false)
                )
                label(for="statusInactive" class="form-check-label") Inactive 

            div(class="form-group")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Save

    else 
        p Please create a role before updating the account! 
        p 
            a(
                href=`${prefixAdmin}/roles/create`
                class="btn btn-secondary"
            ) Create a role